# AWS S3（及 S3 兼容端点）连接配置模板：复制本文件为 s3.txt（同目录）
# 并填入真实值。region 仅供签名，私有化部署（MinIO/RustFS）通常需要
# use_path_style: "true"，region 可省略——S3 兼容端点可直接复用 OSS 的
# AK/SK/桶（本仓库实证于阿里云 OSS 的 S3 兼容端点）。
endpoint: "https://s3.amazonaws.com"
access_key_id: "your-access-key-id"
secret_access_key: "your-secret-access-key"
bucket: "your-bucket-name"
# region: "us-east-1"
# use_path_style: "false"
